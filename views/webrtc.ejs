<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <style>
      body { max-width: 980px; margin: 0 auto; padding: 16px; }
      .videos { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      video { width: 100%; background: #000; border-radius: 8px; height: 320px; object-fit: cover; }
      .controls { margin: 12px 0; display: flex; gap: 8px; align-items: center; }
      .log { font-family: monospace; white-space: pre-wrap; background: #111; color: #0f0; padding: 8px; border-radius: 6px; height: 140px; overflow: auto; }
      h1 { margin-bottom: 8px; }
    </style>
  </head>
  <body>
    <h1>Simple WebRTC Call</h1>
    <p>Open this page in two tabs or share the URL; it carries a <code>?room=...</code> parameter.</p>
    <div class="controls">
      <button id="btnStart">Start</button>
      <button id="btnCall" disabled>Call</button>
      <button id="btnHangup" disabled>Hang Up</button>
      <span id="roomInfo"></span>
    </div>
    <div class="videos">
      <div>
        <h3>Local</h3>
        <video id="localVideo" autoplay playsinline muted></video>
      </div>
      <div>
        <h3>Remote</h3>
        <video id="remoteVideo" autoplay playsinline></video>
      </div>
    </div>
    <h3>Log</h3>
    <div id="log" class="log"></div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/javascripts/webrtc.js"></script>
  </body>
</html>
